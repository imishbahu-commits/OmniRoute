{
  "name": "OmniRoute",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [20128],
  "portsAttributes": {
    "20128": {
      "label": "OmniRoute",
      "onAutoForward": "notify"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "onCreateCommand": "npm install --no-audit --no-fund",
  "waitFor": "onCreateCommand",
  "postAttachCommand": "bash .devcontainer/start-public.sh",
  "remoteEnv": {
    "HOST": "0.0.0.0",
    "PORT": "20128",
    "NODE_OPTIONS": "--max-old-space-size=5120"
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
